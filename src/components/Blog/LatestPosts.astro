---
import {
  getPublishedPosts,
  postPath,
  formatDate,
  dateValue,
  getCover,
} from "../../lib/blog";
import background from "../../assets/background-mafia/background-blog.webp";
import "../../styles/latest-posts.css";
const posts = (await getPublishedPosts()).slice(0, 3);
const entries = await Promise.all(
  posts.map(async (post) => ({ post, cover: await getCover(post.data.cover) }))
);
---

<section id="writing" class="writing-scene" aria-labelledby="writing-title">
  <div
    class="writing-scene__background"
    style={`background-image:url(${background});`}
    aria-hidden="true"
  >
  </div>
  <div class="writing-scene__content">
    <header class="writing-scene__header">
      <p class="writing-scene__eyebrow">
        <span>04</span><i></i> CATATAN &amp; PEMBELAJARAN
      </p>
      <h2 id="writing-title">Tulisan <span>Terbaru.</span></h2>
      <p class="writing-scene__intro">
        Catatan tentang teknologi, pengembangan web, visualisasi data, proyek,
        dan proses belajar.
      </p>
      <div class="writing-scene__actions">
        <a href="/blog/" class="writing-scene__cta"
          >Lihat semua tulisan <span aria-hidden="true">→</span></a
        >
        <span class="writing-scene__book" aria-hidden="true"
          ><svg
            width="25"
            height="25"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            ><path
              d="M12 5c-3-2-6-2-9-1v15c3-1 6-1 9 1 3-2 6-2 9-1V4c-3-1-6-1-9 1Z"
            ></path><path d="M12 5v15"></path></svg
          ></span
        >
      </div>
    </header>
    <div class="writing-scene__posts">
      {
        entries.length ? (
          entries.map(({ post, cover }, index) => (
            <article class="writing-card" id={`latest-post-${index + 1}`}>
              {cover && (
                <img
                  class="writing-card__image"
                  src={cover.src}
                  alt={cover.alt}
                  width={cover.width}
                  height={cover.height}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <div class="writing-card__content">
                <p class="writing-card__category">
                  <span aria-hidden="true">▤</span> {post.data.category}
                </p>
                <h3>
                  <a href={postPath(post)}>{post.data.title}</a>
                </h3>
                <p class="writing-card__description">{post.data.description}</p>
                <div class="writing-card__footer">
                  <p>
                    <span aria-hidden="true">▦</span>{" "}
                    <time datetime={dateValue(post.data.publishedAt)}>
                      {formatDate(post.data.publishedAt)}
                    </time>
                    {post.data.tags[0] && (
                      <>
                        <span aria-hidden="true">· ◇</span>{" "}
                        <span>{post.data.tags[0]}</span>
                      </>
                    )}
                  </p>
                  <a
                    class="writing-card__arrow"
                    href={postPath(post)}
                    aria-label={`Baca ${post.data.title}`}
                  >
                    →
                  </a>
                </div>
              </div>
            </article>
          ))
        ) : (
          <p class="writing-scene__empty">
            Tulisan pertama sedang disiapkan. Kunjungi kembali untuk membaca
            catatan terbaru.
          </p>
        )
      }
      {
        entries.length > 0 && (
          <nav class="writing-scene__numbers" aria-label="Tulisan terbaru">
            {entries.map(({ post }, index) => (
              <a href={postPath(post)} aria-label={`Baca ${post.data.title}`}>
                {String(index + 1).padStart(2, "0")}
              </a>
            ))}
          </nav>
        )
      }
    </div>
  </div>
  <span class="writing-scene__side" aria-hidden="true"
    >WRITE<br />LEARN<br />SHARE</span
  >
  <span class="writing-scene__bottom" aria-hidden="true"
    >SMALL NOTES<br />BIG PROGRESS</span
  >
</section>
