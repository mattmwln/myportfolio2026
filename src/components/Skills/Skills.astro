---
import SkillsContent from "./SkillsContent";
import backgroundSkills from "../../assets/background-mafia/background-skills.webp";
import "../../styles/skills.css";
---

<section id="skills" class="relative isolate overflow-hidden bg-[#050505]">
  <div
    aria-hidden="true"
    class="skills-background pointer-events-none absolute inset-0 z-0"
    style={`background-image: url(${backgroundSkills});`}
  >
  </div>
  <div
    class="skills-overlay pointer-events-none absolute inset-0 z-[1]"
    aria-hidden="true"
  >
  </div>

  <SkillsContent client:visible />
</section>
