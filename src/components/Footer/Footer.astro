---
import SocialMedia from "./SocialMedia";
import { contactEmail, currentWork } from "../../data/person";
import footerBackground from "../../assets/background-mafia/background-footer.webp";
import "../../styles/footer.css";
---

<footer id="footer" class="footer-scene">
  <div
    class="footer-scene__background"
    style={`background-image: url(${footerBackground});`}
    aria-hidden="true"
  >
  </div>
  <div class="footer-scene__shade" aria-hidden="true"></div>

  <div class="footer-scene__content">
    <div class="footer-scene__columns">
      <div class="footer-intro">
        <div class="footer-brand" aria-label="Rahmat Maulana">
          <span>RM</span><span class="footer-brand__line"></span>
        </div>
        <p class="footer-eyebrow">Let's connect</p>
        <h2>Maulana<span>.</span></h2>
        <p class="footer-intro__title">Hubungi <strong>Saya</strong></p>
        <p class="footer-intro__copy">
          Kirim pesan, saya akan merespons secepat mungkin.
        </p>
        <div class="footer-social"><SocialMedia client:load /></div>
      </div>

      <form id="contact-form" class="footer-form">
        <label for="contact-email">Email Anda</label>
        <div class="footer-form__field">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
            ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path
              d="m3 7 9 7 9-7"></path></svg
          >
          <input
            id="contact-email"
            type="email"
            name="email"
            autocomplete="email"
            placeholder="Email"
            required
          />
        </div>

        <label for="contact-message">Pesan Anda</label>
        <div class="footer-form__field footer-form__field--message">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
            ><path
              d="M20 16a3 3 0 0 1-3 3H8l-5 3V7a3 3 0 0 1 3-3h11a3 3 0 0 1 3 3z"
            ></path><path d="M7 9h10M7 13h7"></path></svg
          >
          <textarea
            id="contact-message"
            name="message"
            placeholder="Pesan"
            required
            rows="4"></textarea>
        </div>

        <div class="footer-form__bottom">
          <button id="submit-button" type="submit" class="footer-form__submit">
            <svg
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.7"
              aria-hidden="true"
              ><path d="m22 2-7 20-4-9-9-4Z"></path><path d="M22 2 11 13"
              ></path></svg
            >
            <span id="button-label">Kirim Pesan</span>
            <span class="footer-form__arrow" aria-hidden="true">→</span>
          </button>
          <p class="footer-form__note">
            <span></span>Tidak spam. Balasan via email.
          </p>
        </div>
      </form>

      <div class="footer-contact">
        <div class="footer-contact__heading">
          <span class="footer-contact__dot"></span>
          <h3>Kontak</h3>
          <span class="footer-contact__line"></span>
          <span class="footer-contact__eyebrow">Get in touch</span>
        </div>

        <div class="footer-contact__cards">
          <div class="footer-contact__card">
            <span class="footer-contact__icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
                ><rect x="3" y="5" width="18" height="14" rx="2"></rect><path
                  d="m3 7 9 7 9-7"></path></svg
              >
            </span>
            <div class="footer-contact__text">
              <span>Email</span><a href={`mailto:${contactEmail}`}
                >{contactEmail}</a
              >
            </div>
            <button
              id="copy-email"
              type="button"
              data-email={contactEmail}
              aria-label="Salin alamat email"
              class="footer-contact__action"
            >
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
                ><rect x="8" y="8" width="12" height="12" rx="2"></rect><path
                  d="M16 8V5a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v9a2 2 0 0 0 2 2h3"
                ></path></svg
              >
            </button>
          </div>
          <div class="footer-contact__card">
            <span class="footer-contact__icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
                ><path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"
                ></path><circle cx="12" cy="10" r="2.5"></circle></svg
              >
            </span>
            <div class="footer-contact__text">
              <span>Lokasi</span><strong>Sumatera Selatan</strong>
            </div>
          </div>
          <div class="footer-contact__card">
            <span class="footer-contact__icon">
              <svg
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                aria-hidden="true"
                ><circle cx="12" cy="7" r="3"></circle><path
                  d="M5 21v-2a7 7 0 0 1 14 0v2H5Z"></path></svg
              >
            </span>
            <div class="footer-contact__text">
              <span>Status</span><strong
                >{currentWork.name}
                <span class="footer-contact__separator">·</span> Sistem Informasi</strong
              ><em>{currentWork.field}</em>
            </div>
            <span class="footer-contact__online" aria-label="Pekerjaan saat ini"
            ></span>
          </div>
        </div>
      </div>
    </div>

    <div class="footer-principles" aria-label="Solve, Build, Grow">
      <div class="footer-principles__item">
        <span class="footer-principles__icon"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
            ><circle cx="12" cy="12" r="8"></circle><circle
              cx="12"
              cy="12"
              r="3"></circle><path d="M18 6 21 3"></path></svg
          ></span
        >
        <span
          ><strong>Solve</strong><small>Turn problems into solutions</small
          ></span
        >
      </div>
      <div class="footer-principles__item">
        <span class="footer-principles__icon"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
            ><path d="m12 2 9 5-9 5-9-5 9-5Z"></path><path
              d="m3 12 9 5 9-5M3 17l9 5 9-5"></path></svg
          ></span
        >
        <span
          ><strong>Build</strong><small>Create digital experiences</small></span
        >
      </div>
      <div class="footer-principles__item">
        <span class="footer-principles__icon"
          ><svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.7"
            aria-hidden="true"
            ><path d="M3 20h18M6 16v-4M11 16V8M16 16V4m-1 1 2-2 2 2"
            ></path></svg
          ></span
        >
        <span><strong>Grow</strong><small>Make an impact</small></span>
      </div>
    </div>
  </div>

  <div class="footer-bottom">
    <div class="footer-bottom__inner">
      <p>© {new Date().getFullYear()} Rahmat Maulana</p>
      <nav aria-label="Navigasi footer">
        <a href="/blog/">Blog</a><span>·</span><span>System Analyst</span><span
          >·</span
        ><span>Frontend</span><span>·</span><span>Data</span>
      </nav>
      <p class="footer-bottom__motto">Ideas to Impact <span></span></p>
    </div>
  </div>
</footer>

<!-- =========================================================
     SUCCESS POPUP
========================================================== -->

<div
  id="success-popup"
  role="status"
  aria-live="polite"
  class="pointer-events-none fixed inset-0 z-[100] flex items-center justify-center bg-black/70 px-6 opacity-0 backdrop-blur-md transition duration-300"
>
  <div
    id="success-box"
    class="relative w-full max-w-xs scale-95 overflow-hidden rounded-[24px] border border-red-500/20 bg-[#0a0707]/95 px-7 py-7 text-center shadow-[0_30px_100px_rgba(0,0,0,0.70)] transition duration-300"
  >
    <div
      class="pointer-events-none absolute -right-20 -top-20 h-48 w-48 rounded-full bg-[radial-gradient(circle,rgba(239,0,0,0.12),transparent_70%)]"
    >
    </div>

    <div
      class="relative mx-auto mb-4 flex h-11 w-11 items-center justify-center rounded-full border border-red-500/20 bg-red-500/[0.06] text-red-500 shadow-[0_0_30px_rgba(239,0,0,0.08)]"
    >
      <svg
        width="19"
        height="19"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="m5 12 4 4L19 6"></path>
      </svg>
    </div>

    <p class="relative text-sm font-semibold text-neutral-100">
      Pesan terkirim
    </p>

    <p class="relative mt-2 text-[11px] leading-5 text-neutral-600">
      Terima kasih. Saya akan segera merespons pesan Anda.
    </p>
  </div>
</div>

<!-- =========================================================
     EMAILJS
========================================================== -->

<script src="https://cdn.jsdelivr.net/npm/@emailjs/browser@3/dist/email.min.js"
></script>

<script is:inline>
  document.addEventListener("DOMContentLoaded", function () {
    const emailjs = window.emailjs;

    if (!emailjs) {
      console.error("EmailJS gagal load");
      return;
    }

    emailjs.init("sAFjkfiUFMLR6HXee");

    const form = document.getElementById("contact-form");
    const popup = document.getElementById("success-popup");
    const box = document.getElementById("success-box");
    const submitButton = document.getElementById("submit-button");
    const buttonLabel = document.getElementById("button-label");
    const copyEmailButton = document.getElementById("copy-email");

    /*
     * COPY EMAIL
     */
    if (copyEmailButton) {
      copyEmailButton.addEventListener("click", async function () {
        const email = copyEmailButton.dataset.email;

        if (!email) return;

        try {
          await navigator.clipboard.writeText(email);

          copyEmailButton.style.background = "rgba(239, 0, 0, 0.08)";
          copyEmailButton.style.color = "rgb(248, 113, 113)";

          setTimeout(function () {
            copyEmailButton.style.background = "";
            copyEmailButton.style.color = "";
          }, 1200);
        } catch (error) {
          console.error("Gagal menyalin email:", error);
        }
      });
    }

    /*
     * CONTACT FORM
     */
    if (!form) return;

    form.addEventListener("submit", function (event) {
      event.preventDefault();

      /*
       * Loading state
       */
      if (submitButton) {
        submitButton.disabled = true;
      }

      if (buttonLabel) {
        buttonLabel.textContent = "Mengirim...";
      }

      /*
       * Send Email
       */
      emailjs
        .sendForm("service_qwr0ri1", "template_emo1iwu", form)
        .then(
          function (response) {
            console.log("SUCCESS:", response);

            form.reset();

            /*
             * Show success popup
             */
            if (popup) {
              popup.classList.remove("opacity-0", "pointer-events-none");

              if (box) {
                box.classList.remove("scale-95");
                box.classList.add("scale-100");
              }

              /*
               * Hide popup
               */
              setTimeout(function () {
                popup.classList.add("opacity-0", "pointer-events-none");

                if (box) {
                  box.classList.remove("scale-100");
                  box.classList.add("scale-95");
                }
              }, 2200);
            }
          },
          function (error) {
            console.error("ERROR DETAIL:", error);

            alert(
              "Gagal mengirim pesan: " + (error.text || "Silakan coba kembali.")
            );
          }
        )
        .finally(function () {
          /*
           * Restore button
           */
          if (submitButton) {
            submitButton.disabled = false;
          }

          if (buttonLabel) {
            buttonLabel.textContent = "Kirim Pesan";
          }
        });
    });
  });
</script>
