---
import ProjectsContent from "./ProjectsContent";
import backgroundProjects from "../../assets/background-mafia/background-projects.webp";
import "../../styles/projects.css";
---

<section id="projects" class="projects-scene" aria-labelledby="projects-title">
  <div
    class="projects-scene__background"
    style={`background-image: url(${backgroundProjects});`}
    aria-hidden="true"
  >
  </div>
  <div class="projects-scene__shade" aria-hidden="true"></div>

  <div class="projects-scene__content">
    <header class="projects-scene__header">
      <p class="projects-scene__eyebrow">
        <span>03</span><i></i> HIGHLIGHT WORK
      </p>
      <h2 id="projects-title" class="projects-scene__title">
        Selected <span>Projects.</span>
      </h2>
      <p class="projects-scene__intro">
        Beberapa proyek pilihan yang telah saya kembangkan,<br
          class="projects-scene__desktop-break"
        />
        dari company project hingga client project.
      </p>
    </header>

    <ProjectsContent />

    <div class="projects-scene__footer" aria-hidden="true">
      <span
        >DEVELOP&nbsp;&nbsp; · &nbsp;&nbsp;DESIGN&nbsp;&nbsp; ·
        &nbsp;&nbsp;SOLVE</span
      >
      <span class="projects-scene__footer-line"><i>✦</i></span>
      <span>BUILD<br />BETTER<br />IDEAS</span>
    </div>
  </div>
  <span class="projects-scene__side" aria-hidden="true"
    >IDEAS<br />INTO<br />SOLUTIONS</span
  >
  <span class="projects-scene__spark" aria-hidden="true">✦</span>
</section>
