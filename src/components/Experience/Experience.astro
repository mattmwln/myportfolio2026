---
import { experiences } from "../Experience/DataExperience";
import backgroundExperience from "../../assets/background-mafia/background-experience.webp";
---

<section id="experience" class="experience-section">
  <!-- Background continuation -->
  <div
    class="experience-bg"
    aria-hidden="true"
    style={`background-image: url(${backgroundExperience});`}
  >
    <div class="bg-noise"></div>
  </div>

  <div class="experience-shell">
    <!-- LEFT -->
    <div class="experience-intro">
      <div class="eyebrow">
        <span></span>
        Professional Career
      </div>

      <h2>
        Pengalaman
        <strong>Kerja.</strong>
      </h2>

      <p class="intro-copy">
        Perjalanan profesional saya dalam mengembangkan solusi digital dan
        memberikan dampak nyata.
      </p>

      <button
        id="see-more-btn"
        hidden
        aria-expanded="false"
        aria-controls="exp-container"
        class="see-more"
      >
        <span class="button-label">See More</span>

        <span class="button-arrow" aria-hidden="true">
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
          >
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </span>
      </button>

      <div class="discipline">
        <span>DISCIPLINE</span>
        <span>BUILDS</span>
        <span>FREEDOM</span>
      </div>
    </div>

    <!-- RIGHT -->
    <div class="timeline-wrap">
      <div class="timeline-line"></div>

      <div id="exp-container" class="timeline">
        {
          experiences.map((exp, index) => (
            <article
              class={`exp-card ${index === 0 ? "is-current" : ""} ${
                index >= 3 ? "extra-exp" : ""
              }`}
            >
              <div class="timeline-node">
                <span />
              </div>

              <div class="exp-icon" aria-hidden="true">
                {index === 0 ? (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                  >
                    <path d="M4 20V10" />
                    <path d="M9 20V4" />
                    <path d="M14 20v-7" />
                    <path d="M19 20V7" />
                    <path d="M2 20h20" />
                  </svg>
                ) : index === 1 ? (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                  >
                    <rect x="3" y="4" width="18" height="12" rx="2" />
                    <path d="M8 20h8" />
                    <path d="M12 16v4" />
                  </svg>
                ) : (
                  <svg
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.7"
                  >
                    <path d="M6 2h9l4 4v16H6z" />
                    <path d="M14 2v5h5" />
                    <path d="M9 12h7" />
                    <path d="M9 16h7" />
                  </svg>
                )}
              </div>

              <div class="exp-content">
                <div class="exp-top">
                  <div class="exp-heading">
                    <h3>{exp.role}</h3>
                    <p>{exp.company}</p>
                  </div>

                  <div class:list={["period", { current: index === 0 }]}>
                    {index === 0 && <span class="status-dot" />}
                    {exp.period}
                  </div>
                </div>

                {exp.points && exp.points.length > 0 && (
                  <ul class="exp-points">
                    {exp.points.map((point) => (
                      <li>
                        <span class="bullet" />
                        <span>{point}</span>
                      </li>
                    ))}
                  </ul>
                )}
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .experience-section {
    --red: #ff1616;
    --red-deep: #7b0000;
    --line: rgba(255, 255, 255, 0.14);
    --muted: rgba(255, 255, 255, 0.6);

    position: relative;
    isolation: isolate;
    min-height: 100vh;
    overflow: hidden;
    background: #050505;
    color: white;
    font-family: "Figtree", sans-serif;
  }

  /* =========================================================
     BACKGROUND
     Dibuat gelap di bagian atas agar nyambung dengan section
     sebelumnya, lalu perlahan membentuk scene baru.
     ========================================================= */

  .experience-bg,
  .bg-noise {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .experience-bg {
    z-index: 0;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  .experience-bg::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
        180deg,
        rgba(0, 0, 0, 0.22) 0%,
        rgba(0, 0, 0, 0.05) 28%,
        rgba(0, 0, 0, 0.28) 100%
      ),
      radial-gradient(ellipse at 50% 0%, rgba(110, 0, 0, 0.08), transparent 52%);
  }

  .bg-noise {
    opacity: 0.13;
    background-image: repeating-linear-gradient(
      115deg,
      transparent 0,
      transparent 5px,
      rgba(255, 255, 255, 0.012) 6px,
      transparent 7px
    );
    mix-blend-mode: screen;
  }

  /* =========================================================
     LAYOUT
     ========================================================= */

  .experience-shell {
    position: relative;
    z-index: 1;
    width: min(1180px, calc(100% - 48px));
    min-height: 100vh;
    margin: 0 auto;
    padding: 120px 0;
    display: grid;
    grid-template-columns: minmax(280px, 0.78fr) minmax(0, 1.7fr);
    gap: clamp(60px, 8vw, 120px);
    align-items: center;
  }

  /* LEFT */

  .experience-intro {
    position: relative;
    z-index: 2;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 15px;
    margin-bottom: 22px;

    color: rgba(255, 255, 255, 0.62);
    font-size: 10px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.35em;
  }

  .eyebrow span {
    display: block;
    width: 26px;
    height: 1px;
    background: var(--red);
    box-shadow: 0 0 8px rgba(255, 0, 0, 0.6);
  }

  .experience-intro h2 {
    margin: 0;
    max-width: 520px;

    font-size: clamp(46px, 5.1vw, 78px);
    line-height: 0.94;
    letter-spacing: -0.055em;
    font-weight: 700;
  }

  .experience-intro h2 strong {
    display: block;
    color: var(--red);
    font-weight: 700;
    text-shadow: 0 0 30px rgba(255, 0, 0, 0.12);
  }

  .intro-copy {
    max-width: 390px;
    margin-top: 30px;

    color: rgba(255, 255, 255, 0.63);
    font-size: 14px;
    line-height: 1.85;
    font-weight: 400;
  }

  /* SEE MORE */

  .see-more {
    position: relative;
    width: 235px;
    height: 64px;
    margin-top: 30px;
    padding: 0 12px 0 30px;

    display: flex;
    align-items: center;
    justify-content: space-between;

    border-radius: 17px;
    border: 1px solid rgba(255, 30, 30, 0.75);

    background: radial-gradient(
        circle at 15% 50%,
        rgba(255, 0, 0, 0.18),
        transparent 45%
      ),
      linear-gradient(100deg, rgba(92, 0, 0, 0.65), rgba(14, 8, 8, 0.88));

    color: white;
    cursor: pointer;

    box-shadow: inset 0 0 25px rgba(255, 0, 0, 0.05),
      0 0 30px rgba(255, 0, 0, 0.12);

    transition: transform 0.35s ease, box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .see-more:hover {
    transform: translateY(-3px);
    border-color: #ff3434;

    box-shadow: inset 0 0 30px rgba(255, 0, 0, 0.09),
      0 0 35px rgba(255, 0, 0, 0.23);
  }

  .button-label {
    font-size: 13px;
    font-weight: 500;
  }

  .button-arrow {
    width: 42px;
    height: 42px;
    border-radius: 50%;

    display: grid;
    place-items: center;

    background: rgba(5, 5, 5, 0.75);
    border: 1px solid rgba(255, 40, 40, 0.35);

    transition: background 0.3s ease, transform 0.3s ease;
  }

  .button-arrow svg {
    width: 17px;
    height: 17px;
  }

  .see-more:hover .button-arrow {
    background: var(--red);
    transform: translateX(2px);
  }

  .discipline {
    position: absolute;
    left: -115px;
    bottom: -155px;

    display: flex;
    flex-direction: column;

    color: rgba(255, 255, 255, 0.38);
    font-size: 8px;
    line-height: 1.8;
    letter-spacing: 0.22em;
  }

  /* =========================================================
     TIMELINE
     ========================================================= */

  .timeline-wrap {
    position: relative;
    z-index: 2;
  }

  .timeline {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .timeline-line {
    position: absolute;
    z-index: 1;

    top: 36px;
    bottom: 36px;
    left: -31px;

    width: 1px;

    background: linear-gradient(
      180deg,
      rgba(255, 30, 30, 0.8),
      rgba(255, 255, 255, 0.22) 30%,
      rgba(255, 255, 255, 0.16) 70%,
      rgba(255, 20, 20, 0.12)
    );
  }

  /* CARD */

  .exp-card {
    position: relative;

    display: grid;
    grid-template-columns: 58px minmax(0, 1fr);
    gap: 20px;

    padding: 28px 30px;

    border-radius: 18px;
    border: 1px solid rgba(255, 255, 255, 0.18);

    background: linear-gradient(
      110deg,
      rgba(14, 12, 12, 0.91),
      rgba(17, 11, 11, 0.82)
    );

    backdrop-filter: blur(15px);
    -webkit-backdrop-filter: blur(15px);

    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.28),
      inset 0 1px 0 rgba(255, 255, 255, 0.025);

    opacity: 0;
    transform: translateX(28px);

    transition: opacity 0.65s ease,
      transform 0.65s cubic-bezier(0.2, 0.8, 0.2, 1), border-color 0.35s ease,
      box-shadow 0.35s ease;
  }

  .exp-card.visible {
    opacity: 1;
    transform: translateX(0);
  }

  .exp-card:hover {
    transform: translateY(-3px);
    border-color: rgba(255, 50, 50, 0.4);

    box-shadow: 0 28px 80px rgba(0, 0, 0, 0.36), 0 0 30px rgba(255, 0, 0, 0.06);
  }

  .exp-card.is-current {
    border-color: rgba(255, 38, 38, 0.72);

    background: radial-gradient(
        circle at 100% 50%,
        rgba(255, 0, 0, 0.08),
        transparent 38%
      ),
      linear-gradient(110deg, rgba(25, 9, 9, 0.94), rgba(13, 10, 10, 0.88));

    box-shadow: 0 22px 70px rgba(0, 0, 0, 0.35), 0 0 30px rgba(255, 0, 0, 0.08),
      inset 0 0 28px rgba(255, 0, 0, 0.025);
  }

  /* node */

  .timeline-node {
    position: absolute;
    left: -42px;
    top: 33px;

    width: 23px;
    height: 23px;

    display: grid;
    place-items: center;

    border-radius: 50%;
    background: #080808;
  }

  .timeline-node span {
    width: 12px;
    height: 12px;

    border-radius: 50%;
    border: 3px solid #676767;
    background: #090909;
  }

  .is-current .timeline-node span {
    border-color: var(--red);
    background: rgba(255, 0, 0, 0.25);

    box-shadow: 0 0 0 4px rgba(255, 0, 0, 0.05), 0 0 18px rgba(255, 0, 0, 0.32);
  }

  /* icon */

  .exp-icon {
    width: 58px;
    height: 58px;

    display: grid;
    place-items: center;

    border-radius: 14px;

    color: #ff4c4c;
    border: 1px solid rgba(255, 55, 55, 0.3);

    background: radial-gradient(
        circle at 50% 50%,
        rgba(255, 0, 0, 0.09),
        transparent 65%
      ),
      rgba(255, 255, 255, 0.018);
  }

  .exp-icon svg {
    width: 25px;
    height: 25px;
  }

  .is-current .exp-icon {
    color: var(--red);
    border-color: rgba(255, 30, 30, 0.6);

    box-shadow: inset 0 0 18px rgba(255, 0, 0, 0.05),
      0 0 20px rgba(255, 0, 0, 0.06);
  }

  /* CONTENT */

  .exp-content {
    min-width: 0;
  }

  .exp-top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }

  .exp-heading h3 {
    margin: 2px 0 3px;

    color: rgba(255, 255, 255, 0.96);
    font-size: 17px;
    line-height: 1.35;
    font-weight: 600;
    letter-spacing: -0.025em;
  }

  .exp-heading p {
    margin: 0;

    color: rgba(255, 255, 255, 0.57);
    font-size: 12px;
    line-height: 1.55;
  }

  .period {
    flex-shrink: 0;
    margin-top: 3px;

    color: rgba(255, 255, 255, 0.6);
    font-size: 11px;
    white-space: nowrap;
  }

  .period.current {
    height: 34px;
    padding: 0 16px;

    display: inline-flex;
    align-items: center;
    gap: 9px;

    color: #ff3030;

    border: 1px solid rgba(255, 40, 40, 0.4);
    border-radius: 999px;

    background: rgba(255, 0, 0, 0.05);
  }

  .status-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;

    background: var(--red);

    box-shadow: 0 0 8px rgba(255, 0, 0, 0.75), 0 0 15px rgba(255, 0, 0, 0.4);

    animation: statusPulse 2s infinite;
  }

  .exp-points {
    margin: 18px 0 0;
    padding: 0;

    display: flex;
    flex-direction: column;
    gap: 8px;

    list-style: none;
  }

  .exp-points li {
    display: grid;
    grid-template-columns: 8px minmax(0, 1fr);
    gap: 11px;
    align-items: start;

    color: rgba(255, 255, 255, 0.61);
    font-size: 11px;
    line-height: 1.6;
  }

  .bullet {
    width: 7px;
    height: 7px;
    margin-top: 5px;

    border-radius: 50%;
    background: var(--red);

    box-shadow: 0 0 8px rgba(255, 0, 0, 0.25);
  }

  /* hidden cards */

  .extra-exp.hidden {
    display: none;
  }

  /* =========================================================
     ANIMATION
     ========================================================= */

  @keyframes statusPulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(255, 0, 0, 0.18), 0 0 8px rgba(255, 0, 0, 0.6);
    }

    50% {
      box-shadow: 0 0 0 6px rgba(255, 0, 0, 0), 0 0 13px rgba(255, 0, 0, 0.85);
    }
  }

  /* =========================================================
     TABLET
     ========================================================= */

  @media (max-width: 1024px) {
    .experience-shell {
      width: min(900px, calc(100% - 40px));
      grid-template-columns: 1fr;
      gap: 75px;
      padding: 100px 0;
    }

    .experience-intro {
      max-width: 620px;
    }

    .experience-intro h2 strong {
      display: inline;
    }

    .intro-copy {
      max-width: 500px;
    }

    .timeline-wrap {
      padding-left: 42px;
    }

    .timeline-line {
      left: 11px;
    }

    .timeline-node {
      left: -42px;
    }

    .discipline {
      display: none;
    }
  }

  /* =========================================================
     MOBILE
     ========================================================= */

  @media (max-width: 640px) {
    .experience-shell {
      width: calc(100% - 32px);
      padding: 82px 0;
      gap: 58px;
    }

    .experience-intro h2 {
      font-size: clamp(44px, 14vw, 62px);
    }

    .intro-copy {
      margin-top: 23px;
      font-size: 13px;
      line-height: 1.75;
    }

    .see-more {
      width: 210px;
      height: 58px;
    }

    .timeline-wrap {
      padding-left: 25px;
    }

    .timeline-line {
      left: 4px;
    }

    .timeline-node {
      left: -31px;
      width: 19px;
      height: 19px;
    }

    .timeline-node span {
      width: 10px;
      height: 10px;
    }

    .exp-card {
      grid-template-columns: 46px minmax(0, 1fr);
      gap: 14px;
      padding: 21px 18px;
      border-radius: 16px;
    }

    .exp-icon {
      width: 46px;
      height: 46px;
      border-radius: 12px;
    }

    .exp-icon svg {
      width: 21px;
      height: 21px;
    }

    .exp-top {
      flex-direction: column;
      gap: 10px;
    }

    .exp-heading h3 {
      font-size: 15px;
    }

    .exp-heading p {
      font-size: 10.5px;
    }

    .period {
      font-size: 10px;
    }

    .period.current {
      height: 28px;
      padding: 0 12px;
    }

    .exp-points {
      grid-column: 1 / -1;
      margin-top: 15px;
    }

    .exp-points li {
      font-size: 10.5px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .exp-card,
    .see-more,
    .button-arrow,
    .status-dot {
      animation: none !important;
      transition: none !important;
    }
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>(".exp-card");
  const seeMoreBtn = document.querySelector<HTMLButtonElement>("#see-more-btn");
  const extraExps = document.querySelectorAll<HTMLElement>(".extra-exp");

  extraExps.forEach((element) => {
    element.classList.add("hidden");
  });

  if (seeMoreBtn && extraExps.length > 0) {
    seeMoreBtn.hidden = false;
  }

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (!entry.isIntersecting) return;

        const card = entry.target as HTMLElement;

        window.setTimeout(() => {
          card.classList.add("visible");
        }, 100);

        observer.unobserve(card);
      });
    },
    {
      threshold: 0.16,
      rootMargin: "0px 0px -30px 0px",
    }
  );

  cards.forEach((card) => {
    if (!card.classList.contains("hidden")) {
      observer.observe(card);
    }
  });

  if (seeMoreBtn) {
    let expanded = false;

    seeMoreBtn.addEventListener("click", () => {
      expanded = !expanded;

      seeMoreBtn.setAttribute("aria-expanded", String(expanded));

      const label = seeMoreBtn.querySelector<HTMLElement>(".button-label");

      if (label) {
        label.textContent = expanded ? "Show Less" : "See More";
      }

      extraExps.forEach((element, index) => {
        if (expanded) {
          element.classList.remove("hidden");

          window.setTimeout(() => {
            element.classList.add("visible");
          }, index * 110);
        } else {
          element.classList.remove("visible");

          window.setTimeout(() => {
            element.classList.add("hidden");
          }, 350);
        }
      });
    });
  }
</script>
