---
import { DATA_DESIGN } from "./DataDesign";
import background from "../../assets/background-mafia/background-design.webp";
import "../../styles/design.css";
const selected = "mac";
---

<section id="design" class="design-scene" aria-labelledby="design-title">
  <div
    class="design-scene__background"
    style={`background-image:url(${background});`}
    aria-hidden="true"
  >
  </div>
  <div class="design-scene__content">
    <header class="design-scene__header">
      <div class="design-scene__ornament" aria-hidden="true">
        <span></span>✦<span></span>
      </div>
      <p>PROJECT DESIGN</p>
      <h2 id="design-title">Social <span>Media</span></h2>
      <p class="design-scene__intro">
        Visual content for stronger brand presence.
      </p>
    </header>
    <div class="design-scene__columns">
      <div class="design-accordion">
        {
          Object.entries(DATA_DESIGN).map(([key, item], index) => (
            <div
              class={`design-item${key === selected ? " is-active" : ""}`}
              data-design-key={key}
            >
              <h3>
                <button
                  type="button"
                  aria-expanded={key === selected}
                  aria-controls={`design-panel-${key}`}
                >
                  <span class="design-item__number">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <>
                    <span>{item.title}</span>
                    <span class="design-item__chevron" aria-hidden="true">
                      ⌄
                    </span>
                  </>
                </button>
              </h3>
              <div
                id={`design-panel-${key}`}
                class="design-item__panel"
                hidden={key !== selected}
              >
                <p>{item.description}</p>
                <div class="design-item__mobile">
                  <img
                    class="design-mockup"
                    src={item.mockupImg}
                    alt={`Mockup tiga ponsel menampilkan ${item.title}`}
                    width="1536"
                    height="1024"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </div>
            </div>
          ))
        }
      </div>
      <div class="design-scene__visuals">
        {
          Object.entries(DATA_DESIGN).map(([key, item]) => (
            <div
              class="design-visual"
              data-design-visual={key}
              hidden={key !== selected}
            >
              <img
                class="design-mockup"
                src={item.mockupImg}
                alt={`Mockup tiga ponsel menampilkan ${item.title}`}
                width="1536"
                height="1024"
                loading="lazy"
                decoding="async"
              />
            </div>
          ))
        }
      </div>
    </div>
    <div class="design-scene__footer" aria-hidden="true">
      <span>IDEAS / DESIGN / VISUAL / IMPACT</span><span
        >✦ &nbsp; SOCIAL MEDIA<br />BRAND GROWTH</span
      >
    </div>
  </div>
  <span class="design-scene__side" aria-hidden="true"
    >CREATE<br />ENGAGE<br />INSPIRE</span
  >
</section>

<script>
  const section = document.querySelector("#design");
  const items = section?.querySelectorAll<HTMLElement>(".design-item");
  items?.forEach((item) => {
    item.querySelector("button")?.addEventListener("click", () => {
      items.forEach((other) => {
        const active = other === item;
        other.classList.toggle("is-active", active);
        other
          .querySelector("button")
          ?.setAttribute("aria-expanded", String(active));
        const panel = other.querySelector<HTMLElement>(".design-item__panel");
        if (panel) panel.hidden = !active;
      });
      section
        ?.querySelectorAll<HTMLElement>("[data-design-visual]")
        .forEach((visual) => {
          visual.hidden =
            visual.dataset.designVisual !== item.dataset.designKey;
        });
    });
  });
</script>
