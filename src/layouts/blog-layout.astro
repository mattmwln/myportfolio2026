---
import SEO from "../components/SEO.astro";
import type { ArticleMetadata } from "../data/structured-data";
import { person, socialProfiles } from "../data/person";
interface Props {
  title: string;
  description: string;
  collection?: boolean;
  postUrls?: string[];
  article?: ArticleMetadata;
  cover?: { src: string; alt: string; width: number; height: number };
}
---

<!DOCTYPE html>
<html lang="id">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SEO {...Astro.props} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Figtree:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="bg-white text-neutral-900 font-figtree">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 bg-white p-3"
      >Lewati ke konten</a
    >
    <header class="border-b border-neutral-200">
      <div
        class="max-w-6xl mx-auto px-6 py-6 flex flex-wrap items-center justify-between gap-5"
      >
        <a href="/" class="font-bold text-xl"
          >Rahmat Maulana<span class="text-neutral-400">.</span></a
        >
        <nav
          aria-label="Navigasi utama"
          class="flex flex-wrap gap-5 text-sm font-medium"
        >
          <a href="/#profile">Profil</a><a href="/#experience">Pengalaman</a>
          <a href="/#projects">Projects</a><a href="/blog/">Blog</a><a
            href="/#footer">Kontak</a
          >
        </nav>
      </div>
    </header>
    <main id="main-content" class="max-w-6xl mx-auto px-6 py-14 md:py-20">
      <slot />
    </main>
    <footer
      class="border-t border-neutral-200 px-6 py-10 text-sm text-neutral-600"
    >
      <div
        class="max-w-6xl mx-auto flex flex-col sm:flex-row justify-between gap-6"
      >
        <p>© {new Date().getFullYear()} <a href="/">{person.name}</a></p>
        <nav aria-label="Profil resmi dan tulisan" class="flex flex-wrap gap-5">
          <a href="/blog/">Blog</a><a href="/rss.xml">RSS</a>
          {
            socialProfiles.map((profile) => (
              <a href={profile.url} target="_blank" rel="noopener noreferrer">
                {profile.name}
              </a>
            ))
          }
        </nav>
      </div>
    </footer>
    <style is:global>
      :focus-visible {
        outline: 2px solid #2563eb;
        outline-offset: 4px;
      }
      .blog-prose {
        font-size: 1.125rem;
        line-height: 1.85;
        overflow-wrap: anywhere;
      }
      .blog-prose > * + * {
        margin-top: 1.4em;
      }
      .blog-prose h2 {
        font-size: 1.75rem;
        line-height: 1.35;
        font-weight: 800;
        margin-top: 2em;
      }
      .blog-prose h3 {
        font-size: 1.4rem;
        font-weight: 700;
      }
      .blog-prose h4,
      .blog-prose h5,
      .blog-prose h6 {
        font-size: 1.15rem;
        font-weight: 700;
      }
      .blog-prose a {
        text-decoration: underline;
        text-underline-offset: 3px;
      }
      .blog-prose ul {
        list-style: disc;
        padding-left: 1.5em;
      }
      .blog-prose ol {
        list-style: decimal;
        padding-left: 1.5em;
      }
      .blog-prose li + li {
        margin-top: 0.4em;
      }
      .blog-prose img {
        max-width: 100%;
        height: auto;
        border-radius: 1rem;
      }
      .blog-prose pre {
        max-width: 100%;
        overflow-x: auto;
        padding: 1.25rem;
        border-radius: 1rem;
        font-size: 0.875rem;
      }
      .blog-prose code {
        overflow-wrap: anywhere;
        font-size: 0.9em;
      }
      .blog-prose pre code {
        overflow-wrap: normal;
      }
      .blog-prose blockquote {
        border-left: 3px solid #d4d4d4;
        padding-left: 1.25rem;
        color: #525252;
      }
      .blog-prose table {
        display: block;
        max-width: 100%;
        overflow-x: auto;
        border-collapse: collapse;
      }
      .blog-prose th,
      .blog-prose td {
        padding: 0.6rem;
        border: 1px solid #d4d4d4;
      }
      @media (max-width: 640px) {
        .blog-prose {
          font-size: 1rem;
        }
        .blog-prose h2 {
          font-size: 1.5rem;
        }
      }
    </style>
  </body>
</html>
